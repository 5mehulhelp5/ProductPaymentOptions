#!/usr/bin/env bash
# Checks before every commit, on the whole module. The PHP tools run inside the Docker container of the Magento dev/QA
# environment (PHP 8.3), see dev/ci/in-container.sh; when it is not running they are skipped with a warning. ESLint runs on the host.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

IC=dev/ci/in-container.sh
step() { printf '\n==> %s\n' "$1"; }

step "Sync the checkout into the container"
$IC --sync
export IN_CONTAINER_SYNCED=1

step "Blacklist (debug leftovers, forbidden constructs)"
$IC php dev/ci/blacklist.php

step "ESLint (host)"
npx --no-install eslint --max-warnings 0 view

step "PHPCS (Magento2, warnings block)"
$IC php -d short_open_tag=0 vendor/bin/phpcs --no-cache

step "PHPMD (Magento rule set)"
$IC composer --no-interaction run-script phpmd

step "phpcpd (5 lines / 70 tokens)"
$IC bash dev/ci/phpcpd.sh Block Model ViewModel

echo
echo "pre-commit: OK"
