declare(strict_types=1);

use Fineweb\ProductPaymentOptions\ViewModel\PaymentOptions;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var PaymentOptions $viewModel */

$viewModel = $block->getData('view_model');
$options = $viewModel->getOptions();
?>
<?php if ($options): ?>
    <div class="fineweb-payment-options" data-role="fineweb-payment-options">
        <button type="button"
                class="action primary tocart fineweb-payment-options__button"
                data-action="open-payment-options">
            <?= $escaper->escapeHtml(__('View Payment Options')) ?>
        </button>

        <div class="fineweb-payment-options__modal" data-role="payment-options-modal">
            <ul class="fineweb-payment-options__list">
                <?php foreach ($options as $key => $option): ?>
                    <li class="fineweb-payment-options__option"
                        data-role="payment-option"
                        data-option-key="<?= $escaper->escapeHtmlAttr((string) $key) ?>">
                        <span class="fineweb-payment-options__title">
                            <?= $escaper->escapeHtml($option['payment_method']) ?>
                        </span>
                        <?php if ($option['payment_method_content'] !== ''): ?>
                            <span class="fineweb-payment-options__note">
                                <?= $escaper->escapeHtml($option['payment_method_content']) ?>
                            </span>
                        <?php endif; ?>
                        <div class="fineweb-payment-options__prices" data-role="payment-option-prices"></div>
                    </li>
                <?php endforeach; ?>
            </ul>
        </div>
    </div>

    <script type="text/x-magento-init">
        <?= /* @noEscape */ $viewModel->getInitConfig() ?>
    </script>
<?php endif; ?>
